<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<!-- Modified by the Cadex project, 2026. See docs/FREECAD.md. -->
<package format="1">
  <name>Built-In Preference Packs</name>
  <description>Preference Packs included with the FreeCAD distribution</description>
  <version>1.0.0</version>
  <maintainer email="noreply@cadex">Cadex Authors</maintainer>
  <license file="../../LICENSE">LGPL2</license>
  <url type="repository">https://github.com/FreeCAD/FreeCAD</url>
  <content>
    <preferencepack>
      <name>FreeCAD Classic</name>
      <type>Theme</type>
      <description>Removes stylesheets, and applies the classic purple/gray background. Resets all colors to default</description>
      <version>1.0.0</version>
      <tag>built-in</tag>
      <tag>background</tag>
      <tag>no stylesheet</tag>
      <tag>classic theme</tag>
    </preferencepack>
    <preferencepack>
      <name>FreeCAD Light</name>
      <type>Theme</type>
      <description>Applies a basic light theme.</description>
      <version>1.0.0</version>
      <tag>built-in</tag>
      <tag>background</tag>
      <tag>light</tag>
    </preferencepack>
    <preferencepack>
      <name>FreeCAD Dark</name>
      <type>Theme</type>
      <description>Applies a basic dark theme.</description>
      <version>1.0.0</version>
      <tag>built-in</tag>
      <tag>background</tag>
      <tag>dark</tag>
    </preferencepack>
    <preferencepack>
      <name>CadexLight</name>
      <type>Theme</type>
      <description>Applies the modern light theme for Cadex.</description>
      <version>2026.07.02</version>
      <tag>built-in</tag>
      <tag>background</tag>
      <tag>light</tag>
      <tag>cadex-default</tag>
    </preferencepack>
    <preferencepack>
      <name>CadexDark</name>
      <type>Theme</type>
      <description>Applies the modern dark theme for Cadex.</description>
      <version>2026.07.02</version>
      <tag>built-in</tag>
      <tag>background</tag>
      <tag>dark</tag>
      <tag>cadex-default</tag>
    </preferencepack>
    <preferencepack>
      <name>CadexMono</name>
      <type>Theme</type>
      <description>Applies the monochrome charcoal/grey/black/white theme for Cadex.</description>
      <version>2026.07.02</version>
      <tag>built-in</tag>
      <tag>background</tag>
      <tag>dark</tag>
      <tag>monochrome</tag>
      <tag>cadex-default</tag>
    </preferencepack>
    <preferencepack>
      <name>Cadex Preferences</name>
      <type>Preference Pack</type>
      <description>Applies recommended Cadex UI preferences.</description>
      <version>2026.07.02</version>
      <tag>built-in</tag>
      <tag>cadex-default</tag>
    </preferencepack>
  </content>
</package>
