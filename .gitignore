# Local reference material (an untracked asset directory at the checkout root)
/reference/
# file types to ignore
.*
!*.gitattributes
!*.gitignore
# The governor skills are the workflows AGENTS.md tells an agent to run, so
# they have to travel with the repo — `.*` above would otherwise hide them and a
# fresh clone would get the contract without the means to follow it. Only
# skills/ is un-ignored; the rest of .claude/ stays local.
!/.claude/
/.claude/*
!/.claude/skills/
!/.clang-format
!/.clang-tidy
!/.git-blame-ignore-revs
!/.gitattributes
!/.github/
!/.gitignore
!/.gitmodules
!/.ouroboros/
# The governor graph lives in the Flywheel local repository at the checkout root
# (`.flywheel/`) with governor's lock and snapshot cache in `.governor/`; `.*` above
# keeps both out of git (ADR-671, ADR-672).
!/.pre-commit-config.yaml
!/.pylintrc
*.clangd
*.DS_Store
*.dep
*.exp
*.kdev4
*.lib
*.manifest
*.o
*.obj
!/data/tests/mesh.obj
*.orig
*.output
*.pch
*.pyc
__pycache__/
*~
CMakeCache.txt
CMakeFiles/
CMakeLists.txt.user
Makefile
cmake_install.cmake
config.h
install_manifest.txt
/.vscode/
/Mod/
/bin/
/build-*/
/build/
/cmake-build*/
/doc/
/lib/
/src/3rdParty/Clipper2/Clipper2Lib/include/clipper2/clipper.version.h
tags
/CMakeUserPresets.json
Testing
compile_commands.json
*.sublime-project
*.sublime-workspace
# pixi environments
*.egg-info
.pixi
goals.md
#explicitly ignore local env
.env
# The remote-training config (ADR-089): a host, a repo path, a venv path and
# a path to an ssh key. Already ignored by the `.*` rule at the top of this
# file -- named again here so it stays ignored if that rule is ever loosened,
# because the allowlist beside it shows the rule is edited.
training/.remote.env
build/engine/

# the CLI's default project root, so `./cadex -p ...` run without --project
# in a checkout leaves a project rather than a diff (docs/CLI.md)
.cadex/

# MuJoCo writes its warning log into the process working directory, so a
# dynamics test that deliberately diverges leaves one in the repo root. It
# is a runtime artifact, never a source file (M4).
MUJOCO_LOG.TXT

# ouroboros run state
.ouroboros/runs/

# presentation images tiled from several projects (cadex hero-grid, ADR-677)
/showcase/
