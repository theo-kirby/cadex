# training/remote.env.example -- the configuration `remote_train.sh` reads.
#
# Copy this file to `training/.remote.env` and fill it in. That name is a
# dotfile, which `.gitignore`'s `.*` rule already ignores, and it is named
# again explicitly under the "explicitly ignore local env" block so it stays
# ignored if that rule is ever loosened.
#
# This file is committed and is deliberately NOT a dotfile: a configuration
# example nobody can see is a configuration example nobody fills in.
#
# There is no password variable and there will not be one. `ssh` has no
# non-interactive password path without `sshpass`, and a plaintext secret on
# disk is a worse thing to own than a path to a key file.

# The box. A hostname, an IP, or -- preferably -- an alias you have already
# defined in ~/.ssh/config, in which case the three variables below may all
# be left empty and ssh will supply them.
CADEX_TRAIN_SSH_HOST=

# The login user. Optional: leave empty when the host is a ~/.ssh/config
# alias that names a `User`, or when your local username matches.
CADEX_TRAIN_SSH_USER=

# Path to the *private* key, passed to ssh and rsync as `-i`. Optional when
# ~/.ssh/config or an agent already resolves the identity. Never the key
# itself -- only a path to it.
CADEX_TRAIN_SSH_KEY=

# The ssh port. Leave at 22 unless the box says otherwise.
CADEX_TRAIN_SSH_PORT=22

# The repository checkout on the box. `remote_train.sh` runs
# `$CADEX_TRAIN_REPO/training/cadex_train.py` out of it, so the trainer that
# runs is whatever revision that checkout is at -- and the policy records
# `trainer_sha256`, so which one it was is recoverable afterwards.
CADEX_TRAIN_REPO=

# The virtualenv on the box, built from `training/requirements.txt` (see
# SETUP.md path (a) or (c)). CHECKED, NEVER CREATED: `check` exits non-zero
# naming this path if it is absent rather than building one for you. A venv
# this script silently created is a venv nobody knows the contents of, and
# the whole point of the exact pins is knowing.
CADEX_TRAIN_VENV=

# Scratch directory on the box. The bundle and its model XML are rsynced
# into a per-run subdirectory of this, side by side, and the policy is
# written here before being copied back.
CADEX_TRAIN_WORK=
