[submodule "src/3rdParty/OndselSolver"]
	path = src/3rdParty/OndselSolver
	url = https://github.com/FreeCAD/OndselSolver.git
# The shell's precompiled library sets (1.3 GB each). Content, never ours:
# `update = none` keeps a plain `git submodule update --init --recursive`
# from dragging all four platforms down. Nothing checks them out any more:
# the shell is disabled (ADR-495), and these go with its delete commit.
[submodule "shell/lib/linux_x64"]
	update = none
	path = shell/lib/linux_x64
	url = https://projects.blender.org/blender/lib-linux_x64.git
	branch = main
[submodule "shell/lib/macos_arm64"]
	update = none
	path = shell/lib/macos_arm64
	url = https://projects.blender.org/blender/lib-macos_arm64.git
	branch = main
[submodule "shell/lib/windows_x64"]
	update = none
	path = shell/lib/windows_x64
	url = https://projects.blender.org/blender/lib-windows_x64.git
	branch = main
[submodule "shell/lib/windows_arm64"]
	update = none
	path = shell/lib/windows_arm64
	url = https://projects.blender.org/blender/lib-windows_arm64.git
	branch = main
